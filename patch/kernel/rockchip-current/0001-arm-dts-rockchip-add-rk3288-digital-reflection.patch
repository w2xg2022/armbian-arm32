+++ b/arch/arm/boot/dts/rockchip/rk3288-digital-reflection.dts
@@ -0,0 +1,106 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Digital Reflection RK3288 (rk3288-dr)
+ *
+ * Single board computer: RK3288 quad-core, 2GB RAM, 1x Gigabit
+ * Ethernet (RTL8211E), 1x HDMI, 1x USB 2.0 A port (behind an
+ * on-board USB hub), 5V/2.5A DC input.
+ *
+ * The hardware is very close to the Firefly-RK3288, so this board
+ * is described as a delta on top of rk3288-firefly.dtsi.
+ */
+
+/dts-v1/;
+#include "rk3288-firefly.dtsi"
+
+/ {
+	model = "Digital Reflection RK3288";
+	compatible = "digital-reflection,rk3288-dr", "rockchip,rk3288";
+
+	hdmi-sound {
+		compatible = "simple-audio-card";
+		simple-audio-card,format = "i2s";
+		simple-audio-card,mclk-fs = <256>;
+		simple-audio-card,name = "HDMI";
+		status = "okay";
+
+		simple-audio-card,codec {
+			sound-dai = <&hdmi>;
+		};
+
+		simple-audio-card,cpu {
+			sound-dai = <&i2s>;
+		};
+	};
+};
+
+&ir {
+	gpios = <&gpio7 RK_PA0 GPIO_ACTIVE_LOW>;
+};
+
+&pinctrl {
+	act8846 {
+		pmic_vsel: pmic-vsel {
+			rockchip,pins = <7 RK_PB6 RK_FUNC_GPIO &pcfg_output_low>;
+		};
+	};
+
+	ir {
+		ir_int: ir-int {
+			rockchip,pins = <7 RK_PA0 RK_FUNC_GPIO &pcfg_pull_up>;
+		};
+	};
+};
+
+&pwm1 {
+	status = "okay";
+};
+
+/*
+ * Gigabit Ethernet: this board's RTL8211E samples RXD too early with
+ * the Firefly default of 0x10, producing mmc_rx_crc_error and heavy
+ * packet loss at 1000Mbit. 0x18 was measured good here (0 CRC
+ * errors, 0% loss with 1400 byte flood ping).
+ */
+&gmac {
+	tx_delay = <0x30>;
+	rx_delay = <0x18>;
+};
+
+/* I2S only feeds the HDMI audio codec on this board */
+&i2s {
+	status = "okay";
+};
+
+/*
+ * USB host 1 (ff540000): drives the on-board USB 2.0 hub that the
+ * single external A port sits behind.
+ */
+&usb_host1 {
+	vbus-supply = <&vcc_host_5v>;
+	snps,usb2-enable-hub-mode;
+	g-np-tx-fifo-size = <16>;
+	g-rx-fifo-size = <275>;
+	g-tx-fifo-size = <256 128 128 64 64 32>;
+};
+
+/*
+ * USB OTG (ff580000): wired to the same single A port, forced into
+ * host mode; the PHY reset is driven from GPIO7_B0.
+ */
+&usb_otg {
+	dr_mode = "host";
+	vbus-supply = <&vcc_otg_5v>;
+	snps,reset-active-low;
+	snps,reset-delays-us = <0 10000 1000000>;
+	snps,reset-gpio = <&gpio7 RK_PB0 GPIO_ACTIVE_LOW>;
+};
+
+/* Let the 5V rails settle before the hub / port is used */
+&vcc_host_5v {
+	startup-delay-us = <100000>;
+};
+
+&vcc_otg_5v {
+	startup-delay-us = <100000>;
+};
